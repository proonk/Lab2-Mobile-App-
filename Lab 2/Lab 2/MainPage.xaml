<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lab_2.MainPage"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*" BackgroundColor="#F3F3F3">
        <BoxView Grid.Row="0" Color="#4A3AFF" HeightRequest="60"/>
        <Label Grid.Row="0" Text="VINCENT TIONG YONG HAN (BCS23090053)"
               TextColor="White" 
               VerticalOptions="Center" 
               HorizontalOptions="Center" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="10">

                <Image Source="image10.jpg" 
                       Aspect="AspectFill" 
                       HeightRequest="300" />

                <Frame CornerRadius="20" 
                       Padding="20" 
                       Margin="15,-40,15,0" 
                       BackgroundColor="#FEF9E8" 
                       HasShadow="True">
                    <VerticalStackLayout Spacing="15">
                        <Grid ColumnDefinitions="*,Auto,Auto" 
                              RowDefinitions="Auto">
                            <Label Text="Robin Hood" 
                                   FontSize="24" 
                                   FontAttributes="Bold" 
                                   TextColor="Black"/>
                            <Label Grid.Column="1" 
                                   Text="1 year old" 
                                   VerticalOptions="Center"/>
                            <Image Grid.Column="2" 
                                   Source="male_icon.png" 
                                   HeightRequest="20" 
                                   WidthRequest="20" 
                                   VerticalOptions="Center"/>
                        </Grid>

                        <HorizontalStackLayout Spacing="10">
                            <Image Source="location_icon.png" HeightRequest="16" WidthRequest="16" VerticalOptions="Start"/>
                            <Label Text="3B,Lorong 88, Taman Rantau Panjang, 96000 Sibu, Sarawak" TextColor="Gray"/>
                        </HorizontalStackLayout>

                        <BoxView HeightRequest="1" Color="LightGray" />

                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                            <Frame CornerRadius="25" HeightRequest="50" WidthRequest="50" Padding="0" IsClippedToBounds="True">
                                <Image Source="owner.jpg" Aspect="AspectFill"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1" Padding="10,0,0,0">
                                <Label Text="XiaoMin" 
                                       FontAttributes="Bold" 
                                       TextColor="Black"/>
                                <Label Text="Owner" TextColor="Gray"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="1.11.2024" TextColor="Gray"/>
                        </Grid>

                        <Label Text="Hi! Robin the Pug is simply a tiny tornado of fur, wrinkles, and endless charm!" TextColor="Gray"/>

                        <Grid ColumnDefinitions="Auto,*" Margin="0,10,0,0">
                            <Button Text="♡" BackgroundColor="White" TextColor="Gray" CornerRadius="15" BorderColor="LightGray" BorderWidth="1" WidthRequest="60"/>
                            <Button Grid.Column="1" Text="Adoption" BackgroundColor="#FFC107" TextColor="White" CornerRadius="15" Margin="10,0,0,0"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>